# Browser-facing URLs. API can stay relative because host nginx proxies /api.
UPTIME_APP_API_BASE_URL=/api/v1

# Full app URL. Keep https:// here.
UPTIME_APP_CLIENT_HOST=https://checkmate.fystack.io

# Hostname only is preferred. https://status.fystack.io also works.
UPTIME_APP_STATUS_PAGE_DOMAIN=status.fystack.io
UPTIME_APP_STATUS_PAGE_SLUG=replace_with_status_page_slug
